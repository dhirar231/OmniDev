---
import Logo from '../components/Logo.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Contact from '../components/Contact.astro';
import { projects } from '../data/projects';
import '@fontsource-variable/dm-sans';
import '@fontsource-variable/manrope';
import '../styles/global.css';
const origin = Astro.site!;
const pageUrl = new URL(import.meta.env.BASE_URL.replace(/\/?$/, '/'), origin);
const configured = origin.hostname !== 'omnidev.example';
const title = 'Omni Dev — Software for business. Products for people.';
const description =
  'Custom business software, web platforms, and everyday digital products. Explore Omni Dev’s work in business operations, invoicing, and habit-building.';
const services = [
  {
    icon: '⌘',
    title: 'Custom business software',
    text: 'Connect your workflows, organize your data, and give your team tools that fit the way they work.',
    tags: 'Management tools / Operations / Reporting',
  },
  {
    icon: '↗',
    title: 'Web platforms & portals',
    text: 'Turn complex processes into clear journeys, from applications and reviews to role-based dashboards.',
    tags: 'Web applications / APIs / Databases',
  },
  {
    icon: '▣',
    title: 'Mobile & desktop apps',
    text: 'Useful software beyond the browser, with local storage, cloud-connected features, and thoughtful interfaces.',
    tags: 'Flutter / Cross-platform / Local-first',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#14241f" />
    <meta name="color-scheme" content="light" />
    <link
      rel="icon"
      type="image/svg+xml"
      href={new URL('favicon.svg', pageUrl)}
    />
    <link rel="canonical" href={pageUrl} />
    <meta
      name="robots"
      content={configured ? 'index,follow' : 'noindex,nofollow'}
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Omni Dev" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={new URL('social-card.png', pageUrl)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Omni Dev — Software for business. Products for people."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('social-card.png', pageUrl)} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header" id="home">
      <div class="container header-inner">
        <Logo />
        <button
          class="menu-toggle"
          aria-expanded="false"
          aria-controls="main-nav"
          hidden
        >
          Menu <span aria-hidden="true">☰</span>
        </button>
        <nav id="main-nav" aria-label="Main navigation">
          <a href="#services">Services</a>
          <a href="#work">Our work</a>
          <a href="#products">Products</a>
          <a href="#about">About</a>
          <a href="#contact" class="nav-cta">
            Let’s talk <span aria-hidden="true">↗</span>
          </a>
        </nav>
      </div>
    </header>
    <main id="main">
      <section class="hero" aria-labelledby="hero-heading">
        <div class="container hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">
              <span class="status-dot"></span> INDEPENDENT THINKING. PURPOSEFUL
              SOFTWARE.
            </p>
            <h1 id="hero-heading">
              Built for business.
              <br />
              Made for <span class="serif">people.</span>
            </h1>
            <p class="hero-description">
              We turn complex challenges into useful software.
              <br class="desktop-break" /> Custom solutions for your company.
              Thoughtful products for everyday life.
            </p>
            <div class="hero-actions">
              <a class="button button-lime" href="#contact">
                Discuss Your Project <span aria-hidden="true">↗</span>
              </a>
              <a class="text-link" href="#work">
                Explore Our Work <span aria-hidden="true">↓</span>
              </a>
            </div>
            <div class="hero-footnote">
              <span class="tiny-mark" aria-hidden="true">
                ✳
              </span>
              <span>
                From the way you work.
                <br />
                To the way you live.
              </span>
            </div>
          </div>
          <div class="hero-art" aria-hidden="true">
            <div class="art-grid"></div>
            <div class="orbital orbital-one"></div>
            <div class="orbital orbital-two"></div>
            <div class="orbital orbital-three"></div>
            <div class="orb-core">
              <svg viewBox="0 0 100 100" fill="none">
                <path
                  d="M25 59C5 59 7 30 26 30c21 0 27 40 49 40 19 0 21-29 1-29-21 0-28 40-49 40"
                  stroke="currentColor"
                  stroke-width="12"
                  stroke-linecap="round"
                  transform="translate(0 -5)"
                />
              </svg>
            </div>
            <div class="art-label label-business">
              <span>⌘</span> FOR BUSINESS <i></i>
            </div>
            <div class="art-label label-people">
              <span>◎</span> FOR EVERYDAY LIFE <i></i>
            </div>
            <div class="art-coordinate">
              OMNI DEV / CONNECTING POSSIBILITIES
            </div>
            <span class="orbit-star star-one">✳</span>
            <span class="orbit-star star-two">+</span>
          </div>
        </div>
        <div class="container hero-bottom">
          <span>GOOD SOFTWARE STARTS WITH REAL NEEDS.</span>
          <span>
            IDEA <i>→</i> DESIGN <i>→</i> DEVELOPMENT <i>→</i> POSSIBILITY
          </span>
        </div>
      </section>
      <div class="capability-strip">
        <div class="container">
          <span>Business systems</span>
          <i>✳</i>
          <span>Web platforms</span>
          <i>✳</i>
          <span>Mobile applications</span>
          <i>✳</i>
          <span>Everyday products</span>
        </div>
      </div>
      <section
        id="services"
        class="section-pad services"
        aria-labelledby="services-heading"
      >
        <div class="container">
          <div class="section-heading">
            <div>
              <p class="eyebrow">
                <span class="section-number">01 /</span> WHAT WE BUILD
              </p>
              <h2 id="services-heading">
                Your ambition.
                <br />
                Our <span class="serif">engineering.</span>
              </h2>
            </div>
            <p>
              Software should make things simpler.
              <br />
              We build around your needs, your users,
              <br />
              and the problems worth solving.
            </p>
          </div>
          <div class="service-grid">
            {services.map((service, i) => (
              <article class="service-card">
                <div class="service-top">
                  <span class="service-icon" aria-hidden="true">
                    {service.icon}
                  </span>
                  <span>0{i + 1}</span>
                </div>
                <h3>{service.title}</h3>
                <p>{service.text}</p>
                <p class="service-tags">{service.tags}</p>
              </article>
            ))}
          </div>
          <div class="tech-strip">
            <span>TOOLS IN OUR WORKSPACE</span>
            <p>
              Flutter <i>/</i> Angular <i>/</i> React <i>/</i> Node.js <i>/</i>{' '}
              Firebase <i>/</i> PostgreSQL
            </p>
          </div>
        </div>
      </section>
      <section
        id="work"
        class="section-pad work"
        aria-labelledby="work-heading"
      >
        <div class="container">
          <div class="section-heading">
            <div>
              <p class="eyebrow">
                <span class="section-number">02 /</span> SELECTED WORK
              </p>
              <h2 id="work-heading">
                Real problems.
                <br />
                <span class="serif">Purpose-built</span> solutions.
              </h2>
            </div>
            <div class="work-intro">
              <p>
                A closer look at the software in our workspace, from operational
                tools to independent products.
              </p>
              <p class="small-note">
                Business examples are anonymized. Visuals are illustrative
                concepts, not application screenshots.
              </p>
            </div>
          </div>
          <div class="work-toolbar">
            <div
              class="filters"
              role="group"
              aria-label="Filter selected work"
              hidden
            >
              <button aria-pressed="true" data-filter="all">
                All work
              </button>
              <button aria-pressed="false" data-filter="business">
                For business
              </button>
              <button aria-pressed="false" data-filter="product">
                Products
              </button>
            </div>
            <span id="work-count" role="status">
              3 selected projects
            </span>
          </div>
          <div class="project-grid">
            {projects.map((project) => (
              <ProjectCard project={project} />
            ))}
          </div>
        </div>
      </section>
      <section
        id="products"
        class="section-pad products"
        aria-labelledby="products-heading"
      >
        <div class="container">
          <div class="section-heading">
            <div>
              <p class="eyebrow">
                <span class="section-number">03 /</span> MADE FOR EVERYDAY LIFE
              </p>
              <h2 id="products-heading">
                Small tools.
                <br />
                <span class="serif">Meaningful</span> possibilities.
              </h2>
            </div>
            <p>
              We also build our own products.
              <br />
              Focused ideas that make everyday tasks
              <br />a little more manageable.
            </p>
          </div>
          <div class="product-feature">
            <div class="habit-art" aria-hidden="true">
              <span class="habit-symbol">
                1<span>%</span>
              </span>
              <div class="habit-card">
                <span>BETTER, TOGETHER.</span>
                <strong>
                  Show up.
                  <br />
                  Check in.
                  <br />
                  Keep going.
                </strong>
                <div class="habit-days">
                  <i>✓</i>
                  <i>✓</i>
                  <i>✓</i>
                  <i>✓</i>
                  <i>↗</i>
                </div>
              </div>
              <span class="habit-art-note">ILLUSTRATIVE CONCEPT</span>
            </div>
            <div class="product-feature-copy">
              <span class="pill">PRODUCT SPOTLIGHT</span>
              <h3>
                1% Better Daily<span class="lime-dot">.</span>
              </h3>
              <p>
                Better habits, with a little company. An accountability app
                built around squads, daily check-ins, reactions, and a shared
                leaderboard.
              </p>
              <ul class="feature-list">
                <li>Build a squad around a shared commitment</li>
                <li>Check in and encourage one another</li>
                <li>Keep consistency in view</li>
              </ul>
              <p class="release-note">
                Public release & download links: to be confirmed.
              </p>
              <a href="#contact" class="text-link">
                Ask About Our Products <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
          <div class="product-secondary">
            <div>
              <span class="product-small-icon" aria-hidden="true">
                f.
              </span>
              <div>
                <h3>Facterly</h3>
                <p>
                  A simpler space for invoices, company details, and PDF
                  exports.
                </p>
              </div>
            </div>
            <a href="#facterly" class="text-link" id="facterly-link">
              Explore the project <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </section>
      <section
        id="about"
        class="section-pad about"
        aria-labelledby="about-heading"
      >
        <div class="container about-grid">
          <div>
            <p class="eyebrow">
              <span class="section-number">04 /</span> HELLO, WE’RE OMNI DEV
            </p>
            <h2 id="about-heading">
              One studio.
              <br />
              Many <span class="serif">possibilities.</span>
            </h2>
          </div>
          <div class="about-copy">
            <p class="large-copy">
              We’re a software company building at the intersection of business
              needs and everyday life.
            </p>
            <p>
              Our work spans operational tools, education platforms, invoicing,
              and social habit-building. Different challenges, connected by one
              idea: technology should be useful to the people using it.
            </p>
            <p>
              We bring that perspective to both custom software for companies
              and products for the general public.
            </p>
            <a href="#process" class="text-link">
              Get to know our approach <span aria-hidden="true">↓</span>
            </a>
          </div>
        </div>
      </section>
      <section
        id="process"
        class="section-pad process"
        aria-labelledby="process-heading"
      >
        <div class="container">
          <div class="section-heading">
            <div>
              <p class="eyebrow">
                <span class="section-number">05 /</span> HOW WE WORK TOGETHER
              </p>
              <h2 id="process-heading">
                Clear steps.
                <br />
                <span class="serif">Shared direction.</span>
              </h2>
            </div>
            <p>
              A practical path from the first conversation
              <br />
              to software you can put to work.
              <br />
              Scope and delivery are agreed together.
            </p>
          </div>
          <ol class="process-grid">
            <li>
              <span class="step-number">
                01 <i>↗</i>
              </span>
              <h3>Understand</h3>
              <p>
                Start with your people, your current workflow, and the problem
                that matters most.
              </p>
            </li>
            <li>
              <span class="step-number">
                02 <i>↗</i>
              </span>
              <h3>Shape</h3>
              <p>
                Map the experience, choose the right tools, and define a focused
                first release.
              </p>
            </li>
            <li>
              <span class="step-number">
                03 <i>↗</i>
              </span>
              <h3>Build & refine</h3>
              <p>
                Develop in clear stages, review together, and test the flows
                your users depend on.
              </p>
            </li>
            <li>
              <span class="step-number">
                04 <i>↗</i>
              </span>
              <h3>Launch & evolve</h3>
              <p>
                Prepare the handover, plan deployment, and agree on what comes
                next.
              </p>
            </li>
          </ol>
        </div>
      </section>
      <section class="principle" aria-label="Our principle">
        <div class="container">
          <span aria-hidden="true">✳</span>
          <p>
            Technology is the tool.
            <br />
            <span>The people are the point.</span>
          </p>
          <span class="eyebrow">06 / THE OMNI DEV MINDSET</span>
        </div>
      </section>
      <Contact />
    </main>
    <footer class="site-footer">
      <div class="container footer-top">
        <div>
          <Logo footer />
          <p>Software for business. Products for people.</p>
        </div>
        <a href="#home" class="text-link">
          Back to top <span aria-hidden="true">↑</span>
        </a>
      </div>
      <div class="container footer-bottom">
        <span>© {new Date().getFullYear()} Omni Dev</span>
        <span>Thoughtfully built. Purposefully simple.</span>
        <a href="#contact">Get in touch ↗</a>
      </div>
    </footer>
    <script src="../scripts/main.ts"></script>
  </body>
</html>
